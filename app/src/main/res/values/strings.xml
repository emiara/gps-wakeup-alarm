    <string name="chk_battery_detail">Stops the system from freezing the app during the ride.</string>
    <string name="chk_exact_alarm">Exact alarms</string>
    <string name="chk_exact_alarm_detail">Lets the app restart its own tracking if Android kills it, and drives the snooze.</string>
    <string name="chk_full_screen">Full-screen alarms</string>
    <string name="chk_full_screen_detail">Lets the alarm take over a locked screen instead of being a quiet banner.</string>
