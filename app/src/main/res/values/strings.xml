    <string name="chk_alarm_channel_detail">The \"Wake-up alarm\" channel must not be silenced or set to low importance.</string>
    <string name="chk_volume">Alarm volume</string>
    <string name="chk_volume_detail">The alarm plays on the alarm stream, separate from your ringer.</string>
